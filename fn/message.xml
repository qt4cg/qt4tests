<?xml version="1.0" encoding="utf-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-message" covers-40="PR629">
   <description>Tests for the fn:message() function (4.0 proposal)</description>
 
   
   
   <dependency type="spec" value="XP40+ XQ40+"/>
   
   <test-case name="message-001">
      <description> Call on fn:message#1 </description>
      <created by="Michael Kay" on="2023-07-25"/>
      <test>message("Hi there!")</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>
   
   <test-case name="message-002">
      <description> Call on fn:message#2 </description>
      <created by="Michael Kay" on="2023-07-25"/>
      <test>message("Hi there!", "Label")</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>
   
   <test-case name="message-003">
      <description> Call on fn:message#2 </description>
      <created by="Michael Kay" on="2023-07-25"/>
      <test>message(("On", "the", "Ning", "Nang", "Nong"), "Milligan")</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>

   <test-case name="message-004">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>message("Hi there!", ())</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>

   <test-case name="message-005">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>message(())</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>

   <test-case name="message-006">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>message(({ 'a': [ 1, (2, 3) ] }, fn($x) { $x }, abs#1, xs:QName('xml:lang')))</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>

   <test-case name="message-007">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <modified by="Gunther Rademacher" on="2026-10-06" change="exclude from XPath tests"/>
      <dependency type="spec" value="XQ40+"/>
      <test>message((attribute a { 1 }, namespace p { 'urn:p' }, text { 'x' }), 'nodes')</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>

   <test-case name="message-008">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>(1 to 5)[if (. mod 2 = 0) then message(., 'even: ') else true()]</test>
      <result>
         <assert-deep-eq>1, 3, 5</assert-deep-eq>
      </result>
   </test-case>

   <test-case name="message-009">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>(1 to 3) ! (message(.), .)</test>
      <result>
         <assert-deep-eq>1, 2, 3</assert-deep-eq>
      </result>
   </test-case>

   <test-case name="message-010">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>for-each(('a', 'b'), message#1)</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>

   <test-case name="message-011">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>message(input := 'x', label := 'y')</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>

   <test-case name="message-012">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>message('x', 1)</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="message-013">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>message('x', ('a', 'b'))</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="message-014">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>message()</test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

   <test-case name="message-015">
      <description>Evaluation of message function.</description>
      <created by="Christian Gruen" on="2026-10-02"/>
      <test>message('x') instance of empty-sequence()</test>
      <result>
         <assert-true/>
      </result>
   </test-case>


</test-set>