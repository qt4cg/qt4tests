            {"substring":"brown", "position":9, "groups":{3: {"value":"brown", "position": 9, "nr": 3, "name": ()}}},
            {"substring":"cow", "position":15, "groups":{4: {"value":"cow", "position": 15, "nr": 4, "name": ()}}}
