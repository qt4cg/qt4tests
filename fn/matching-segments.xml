            {"substring":"an", "position":4, "groups": {1: {"value":"an", "position": 4, "nr": 1, "name": ()}, 
                                                        2: {"value":"n", "position": 5, "nr": 2, "name": ()}}},
            {"substring":"a",  "position":6, "groups": {1: {"value":"a", "position": 6, "nr": 1, "name": ()}, 
                                                        2: {"value":"", "position": 7, "nr": 2, "name": ()}}}
         </assert-deep-eq>
      </result>
   </test-case>
   
