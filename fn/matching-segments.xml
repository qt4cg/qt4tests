   <test-case name="matching-segments-017">
      <description> subtle distinction in the positioning of an empty captured group </description>
      <created by="Michael Kay" on="2026-06-08"/>
      <modified by="Michael Kay" on="2026-08-21" change="PR2842"/>
      <test>matching-segments("banana", "(b)(x?)")</test>
      <result>
         <all-of>
            <assert-deep-eq>
               {"substring": "b", "position": 1, "groups":{1: {"value": "b", "position": 1, "nr": 1, "name": ()}, 
                                                           2: {"value": "", "position": 2, "nr": 2, "name": ()}}}
            </assert-deep-eq>
            <assert-type>fn:matching-segment-record</assert-type>
            <assert>$result?groups instance of map(xs:integer, fn:captured-group-record)+</assert>
         </all-of>
      </result>
   </test-case>
   
