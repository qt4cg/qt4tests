<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-substring-after-last" covers-40="PR2956">
  <description>Tests for the fn:substring-after-last function</description>

  <link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/"
        idref="func-substring-after-last"/>

  <dependency type="spec" value="XP40+ XQ40+"/>

  <test-case name="substring-after-last-001">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("a/b/c", "/")</test>
    <result>
      <assert-eq>"c"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-002">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("archive.tar.gz", ".")</test>
    <result>
      <assert-eq>"gz"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-003">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("aaa", "aa")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-004">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("abcabcd", "abc")</test>
    <result>
      <assert-eq>"d"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-005">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("abc", "x")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-006">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("abc", "")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-007">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("abc", ())</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-008">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("", "a")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-009">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last((), ())</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-010">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("abc/", "/")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-011">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("/abc", "/")</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-012">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("x&#xA;y.z", ".")</test>
    <result>
      <assert-eq>"z"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-013">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:substring-after-last("x" || char(0x1F600) || "x" || char(0x1F600), "x")
      = char(0x1F600)
    </test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="substring-after-last-014">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last(xs:untypedAtomic("a.b.c"), xs:untypedAtomic("."))</test>
    <result>
      <assert-eq>"c"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-015">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:substring-after-last(
        "A-b-B-c",
        "b",
        "http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive"
      )
    </test>
    <result>
      <assert-eq>"-c"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-016">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:substring-after-last(
        "A-b-B-c",
        "b",
        "http://www.w3.org/2005/xpath-functions/collation/codepoint"
      )
    </test>
    <result>
      <assert-eq>"-B-c"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-017">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:substring-after-last(
        "aXbxc",
        "X",
        "http://www.w3.org/2005/xpath-functions/collation/unicode-case-insensitive"
      )
    </test>
    <result>
      <assert-eq>"c"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-018">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <dependency type="spec" value="XQ40+"/>
    <test>
      declare default collation
        'http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive';
      fn:substring-after-last("A-b-B-c", "b")
    </test>
    <result>
      <assert-eq>"-c"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-after-last-019">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last("abc", "b", "http://www.example.com/unknown-collation")</test>
    <result>
      <error code="FOCH0002"/>
    </result>
  </test-case>

  <test-case name="substring-after-last-020">
    <description>Evaluation of the substring-after-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-after-last(12321, "2")</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

</test-set>
