<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-duration-to-seconds" covers-40="PR2953">
  <description>Tests for the fn:duration-to-seconds function</description>

  <link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/"
        idref="func-duration-to-seconds"/>

  <dependency type="spec" value="XP40+ XQ40+"/>

  <test-case name="duration-to-seconds-001">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:dayTimeDuration("PT1M30S"))</test>
    <result>
      <assert-eq>90</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-002">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:dayTimeDuration("P1DT0.5S"))</test>
    <result>
      <assert-eq>86400.5</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-003">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:dayTimeDuration("-PT1H30M"))</test>
    <result>
      <assert-eq>-5400</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-004">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:dayTimeDuration("PT0S"))</test>
    <result>
      <assert-eq>0</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-005">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:dayTimeDuration("PT0.000001S"))</test>
    <result>
      <assert-eq>0.000001</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-006">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:dayTimeDuration("P10000D"))</test>
    <result>
      <assert-eq>864000000</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-007">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(())</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-008">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:dayTimeDuration("PT1S")) instance of xs:decimal</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-009">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      let $duration := xs:dayTimeDuration("P3DT4H5M6.789S")
      return fn:seconds(fn:duration-to-seconds($duration)) eq $duration
    </test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-010">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(fn:seconds(123.456))</test>
    <result>
      <assert-eq>123.456</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-011">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:duration-to-seconds(
        xs:dateTime("2024-01-31T12:00:00Z") - xs:dateTime("1970-01-01T00:00:00Z")
      )
    </test>
    <result>
      <assert-eq>1706702400</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-012">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:untypedAtomic("PT3S"))</test>
    <result>
      <assert-eq>3</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-013">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds(xs:yearMonthDuration("P1M"))</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-014">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <modified by="Christian Gruen" on="2026-10-01" change="xs:duration is relabeled, see issue 469"/>
    <test>fn:duration-to-seconds(xs:duration("PT1S"))</test>
    <result>
      <assert-eq>1</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-015">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:duration-to-seconds("PT3S")</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>
  
  <test-case name="duration-to-seconds-016">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Michael Kay" on="2026-10-01"/>
    <test>fn:duration-to-seconds(xs:yearMonthDuration("P0Y"))</test>
    <result>
      <assert-eq>0</assert-eq>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-017">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-10-01"/>
    <test>fn:duration-to-seconds(xs:duration("P1M"))</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="duration-to-seconds-018">
    <description>Evaluation of the duration-to-seconds function.</description>
    <created by="Christian Gruen" on="2026-10-01"/>
    <test>fn:duration-to-seconds(xs:duration("P1Y0M2D"))</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

</test-set>
