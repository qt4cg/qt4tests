   <test-case name="fn-current-024">
      <description>Default value depends both on current() and on "."</description>
      <created by="Michael Kay" on="2026-08-30"/>
      <modified by="Christian Gruen" on="2026-09-09" change="default value is a sequence"/>
      <dependency type="spec" value="XQ40+"/>
      <test>
         declare context value as xs:integer := 4;
         declare function f($num as xs:string* := replicate(current(), .)) {
           '[' || string-join($num) || ']'
         };
         "X" -> f()
      </test>
      <result>
         <assert-eq>"[XXXX]"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="fn-current-025">
      <description>current() in a dynamically loaded XQuery module</description>
      <created by="Michael Kay" on="2026-08-30"/>
      <modified by="Christian Gruen" on="2026-09-09" change="module declaration was invalid"/>
      <dependency type="spec" value="XQ40+"/>
      <test>
         let $module-text := ``[
          xquery version "4.0";

          module namespace vm = "http://www.w3.org/fots/fn/load-xquery-module/valid/module";
          declare context item as xs:integer external;
          declare variable $vm:fortyTwo := current() * 7;

      ]``

      let $module-ns := "http://www.w3.org/fots/fn/load-xquery-module/valid/module",
          $module := fn:load-xquery-module($module-ns,
                        {'content': $module-text, 'context-item': 6})
      return
        let $vars := $module("variables")
        return
          $vars(QName($module-ns, "fortyTwo"))
      </test>
      <result>
         <assert-eq>42</assert-eq>
      </result>
   </test-case>
   
  
   
   

</test-set>