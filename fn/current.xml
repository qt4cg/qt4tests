   <test-case name="fn-current-019">
      <description>Evaluation of the fn:current function.</description>
      <created by="Christian Gruen" on="2026-09-08"/>
      <dependency type="spec" value="XQ40+"/>
      <test>
         declare context value := 'global';
         declare function local:f($x := ., $y := current()) { $x || $y };
         'local' ! local:f()
