<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-index-of-substring" covers-40="PR2951">
  <description>Tests for the fn:index-of-substring function</description>

  <link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/"
        idref="func-index-of-substring"/>

  <dependency type="spec" value="XP40+ XQ40+"/>

  <test-case name="index-of-substring-001">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("banana", "an")</test>
    <result>
      <assert-deep-eq>2, 4</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-002">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("banana", "a")</test>
    <result>
      <assert-deep-eq>2, 4, 6</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-003">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("banana", "ana")</test>
    <result>
      <assert-deep-eq>2, 4</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-004">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("aaaa", "aa")</test>
    <result>
      <assert-deep-eq>1, 2, 3</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-005">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("banana", "x")</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="index-of-substring-006">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("banana", "banana")</test>
    <result>
      <assert-deep-eq>1</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-007">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("banana", "bananas")</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="index-of-substring-008">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("", "a")</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="index-of-substring-009">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring((), "a")</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="index-of-substring-010">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("abc", "")</test>
    <result>
      <assert-deep-eq>1, 2, 3, 4</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-011">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("", "")</test>
    <result>
      <assert-deep-eq>1</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-012">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring((), "")</test>
    <result>
      <assert-deep-eq>1</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-013">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring(char(0x1F600) || "a" || char(0x1F600) || "a", "a")</test>
    <result>
      <assert-deep-eq>2, 4</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-014">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("a" || char(0x301) || "a", "a")</test>
    <result>
      <assert-deep-eq>1, 3</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-015">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("ABC", "b")</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="index-of-substring-016">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <dependency type="spec" value="XQ40+"/>
    <test>
      declare default collation
        'http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive';
      fn:index-of-substring("ABC", "b")
    </test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="index-of-substring-017">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring(xs:untypedAtomic("abcab"), "b")</test>
    <result>
      <assert-deep-eq>2, 5</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-018">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("abc", "c") instance of xs:integer+</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="index-of-substring-019">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("a.b.c", ".") => foot()</test>
    <result>
      <assert-eq>4</assert-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-020">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring(string-join((1 to 1000) ! "ab"), "b") => count()</test>
    <result>
      <assert-eq>1000</assert-eq>
    </result>
  </test-case>

  <test-case name="index-of-substring-021">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring("abc", ())</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="index-of-substring-022">
    <description>Evaluation of the index-of-substring function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:index-of-substring(12321, "2")</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

</test-set>
