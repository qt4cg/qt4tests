<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-trim-space" covers-40="PR2952">
  <description>Tests for the fn:trim-space function</description>

  <link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/"
        idref="func-trim-space"/>

  <dependency type="spec" value="XP40+ XQ40+"/>

  <test-case name="trim-space-001">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("  abc  ")</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-002">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("abc")</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-003">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-004">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space(())</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-005">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("    ")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-006">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space(" &#x9;&#xA;&#xD;abc&#xD;&#xA;&#x9; ")</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-007">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("  a  b&#x9;&#x9;c  ")</test>
    <result>
      <assert-eq>"a  b&#x9;&#x9;c"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-008">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("  abc  ", { 'side': 'start' })</test>
    <result>
      <assert-eq>"abc  "</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-009">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("  abc  ", { 'side': 'end' })</test>
    <result>
      <assert-eq>"  abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-010">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("  abc  ", { 'side': 'both' })</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-011">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("  abc  ", ())</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-012">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("  ", { 'side': 'start' })</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-013">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("  ", { 'side': 'end' })</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-014">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space(char(0xA0) || "abc" || char(0x2003)) => string-length()</test>
    <result>
      <assert-eq>5</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-015">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space(12)</test>
    <result>
      <assert-eq>"12"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-016">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space(xs:untypedAtomic(" 1 "))</test>
    <result>
      <assert-eq>"1"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-017">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test><![CDATA[fn:trim-space(parse-xml("<a> x </a>")/a)]]></test>
    <result>
      <assert-eq>"x"</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-018">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space(" 1 ") instance of xs:string</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="trim-space-019">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space(("a", "b"))</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="trim-space-020">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space({})</test>
    <result>
      <error code="FOTY0013"/>
    </result>
  </test-case>

  <test-case name="trim-space-021">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("abc", { 'side': 'middle' })</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="trim-space-022">
    <description>Evaluation of the trim-space function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:trim-space("abc", { 'side': 'START' })</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>
  
  <test-case name="trim-space-023">
    <description>Evaluation of the trim-space function.</description>
    <created by="Michael Kay" on="2026-10-07"/>
    <test>fn:trim-space("abc  ", { 'side': 'start' })</test>
    <result>
      <assert-eq>"abc  "</assert-eq>
    </result>
  </test-case>

  <test-case name="trim-space-024">
    <description>Evaluation of the trim-space function.</description>
    <created by="Michael Kay" on="2026-10-07"/>
    <test>fn:trim-space("  abc", { 'side': 'end' })</test>
    <result>
      <assert-eq>"  abc"</assert-eq>
    </result>
  </test-case>
  
  <test-case name="trim-space-025">
    <description>EBV of the trim-space function (may be optimized).</description>
    <created by="Michael Kay" on="2026-10-07"/>
    <test>
      let $x := " xy "
      return if (trim-space($x)) then 100 else 200
    </test>
    <result>
      <assert-eq>100</assert-eq>
    </result>
  </test-case>
  
  <test-case name="trim-space-026">
    <description>trim-space applied to xs:NCName (may be optimized).</description>
    <created by="Michael Kay" on="2026-10-07"/>
    <test>
      trim-space(xs:NCName(' fred '))
    </test>
    <result>
      <assert-eq>"fred"</assert-eq>
    </result>
  </test-case>
  
  <test-case name="trim-space-027">
    <description>trim-space applied to a long string.</description>
    <created by="Michael Kay" on="2026-10-07"/>
    <test>
      trim-space(replicate(char(9), 10000) || 'x' || replicate(char(10), 10000)) 
    </test>
    <result>
      <assert-eq>"x"</assert-eq>
    </result>
  </test-case>


</test-set>
