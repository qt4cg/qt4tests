<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-days-in-month" covers-40="PR2954">
  <description>Tests for the fn:days-in-month function</description>

  <link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/"
        idref="func-days-in-month"/>

  <dependency type="spec" value="XP40+ XQ40+"/>

  <test-case name="days-in-month-001">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:date("2024-02-10"))</test>
    <result>
      <assert-eq>29</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-002">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:date("2023-02-10"))</test>
    <result>
      <assert-eq>28</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-003">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:date("1900-02-01"))</test>
    <result>
      <assert-eq>28</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-004">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:date("2000-02-01"))</test>
    <result>
      <assert-eq>29</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-005">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:gYearMonth("2100-02"))</test>
    <result>
      <assert-eq>28</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-006">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>(1 to 12) ! fn:days-in-month(xs:gYearMonth("2023-" || format-integer(., "00")))</test>
    <result>
      <assert-deep-eq>31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-007">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>(1 to 12) ! fn:days-in-month(xs:gYearMonth("2024-" || format-integer(., "00")))</test>
    <result>
      <assert-deep-eq>31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-008">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:dateTime("2024-02-29T23:59:59Z"))</test>
    <result>
      <assert-eq>29</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-009">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:dateTime("2023-03-01T00:30:00+14:00"))</test>
    <result>
      <assert-eq>31</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-010">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:date("2023-04-30-12:00"))</test>
    <result>
      <assert-eq>30</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-011">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:gYearMonth("2026-04"))</test>
    <result>
      <assert-eq>30</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-012">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(())</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="days-in-month-013">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:untypedAtomic("2024-02-01"))</test>
    <result>
      <assert-eq>29</assert-eq>
    </result>
  </test-case>

  <test-case name="days-in-month-014">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:date("2024-02-01")) instance of xs:integer</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="days-in-month-015">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:gYear("2024"))</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="days-in-month-016">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:gMonth("--02"))</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="days-in-month-017">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month(xs:time("12:00:00"))</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="days-in-month-018">
    <description>Evaluation of the days-in-month function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:days-in-month("2024-02-01")</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

</test-set>
