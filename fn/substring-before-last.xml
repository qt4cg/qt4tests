<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-substring-before-last" covers-40="PR2955">
  <description>Tests for the fn:substring-before-last function</description>

  <link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/"
        idref="func-substring-before-last"/>

  <dependency type="spec" value="XP40+ XQ40+"/>

  <test-case name="substring-before-last-001">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("a/b/c", "/")</test>
    <result>
      <assert-eq>"a/b"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-002">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("tattoo", "t")</test>
    <result>
      <assert-eq>"tat"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-003">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("aaa", "aa")</test>
    <result>
      <assert-eq>"a"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-004">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("abcabc", "abc")</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-005">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("abc", "x")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-006">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("abc", "")</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-007">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("abc", ())</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-008">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("", "a")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-009">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last((), ())</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-010">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("/abc", "/")</test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-011">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("abc/", "/")</test>
    <result>
      <assert-eq>"abc"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-012">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("a/b&#xA;c", "/")</test>
    <result>
      <assert-eq>"a"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-013">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:substring-before-last(char(0x1F600) || "x" || char(0x1F600) || "x", "x")
      = char(0x1F600) || "x" || char(0x1F600)
    </test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="substring-before-last-014">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last(xs:untypedAtomic("a.b.c"), xs:untypedAtomic("."))</test>
    <result>
      <assert-eq>"a.b"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-015">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:substring-before-last(
        "A-b-B-c",
        "b",
        "http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive"
      )
    </test>
    <result>
      <assert-eq>"A-b-"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-016">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:substring-before-last(
        "A-b-B-c",
        "b",
        "http://www.w3.org/2005/xpath-functions/collation/codepoint"
      )
    </test>
    <result>
      <assert-eq>"A-"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-017">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>
      fn:substring-before-last(
        "aXbxc",
        "X",
        "http://www.w3.org/2005/xpath-functions/collation/unicode-case-insensitive"
      )
    </test>
    <result>
      <assert-eq>"aXb"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-018">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <dependency type="spec" value="XQ40+"/>
    <test>
      declare default collation
        'http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive';
      fn:substring-before-last("A-b-B-c", "b")
    </test>
    <result>
      <assert-eq>"A-b-"</assert-eq>
    </result>
  </test-case>

  <test-case name="substring-before-last-019">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last("abc", "b", "http://www.example.com/unknown-collation")</test>
    <result>
      <error code="FOCH0002"/>
    </result>
  </test-case>

  <test-case name="substring-before-last-020">
    <description>Evaluation of the substring-before-last function.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <test>fn:substring-before-last(12321, "2")</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

</test-set>
