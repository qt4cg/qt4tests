<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-uri-collection" covers-30="fn-uri-collection">
   <description>Tests for the uri-collection function</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/"
         idref="func-uri-collection"/>
   <link type="spec" document="FuncOps" section-number="14.8.4" idref="func-uri-collection"/>
   <dependency type="spec" value="XP30+ XQ30+"/>

   <environment name="simple-collection-1">
      <collection uri="http://www.w3.org/2010/09/qt-fots-catalog/collection1">
         <source file="../docs/bib.xml">
            <description>Data for the the XML Query XMP use cases</description>
            <created by="XQuery WG" on="2005-02-11"/>
         </source>
         <source file="../docs/reviews.xml">
            <description>Data for the the XML Query XMP use cases</description>
            <created by="XQuery WG" on="2005-02-11"/>
         </source>
      </collection>
      <static-base-uri uri="http://www.w3.org/2010/09/qt-fots-catalog/"/>
   </environment>

   <test-case name="fn-uri-collection-1">
      <description> Evaluation of an fn:uri-collection function with wrong arity.  Inspired by fn-collection-1. </description>
      <created by="Josh Spiegel" on="2012-10-02"/>
      <modified by="Christian Gruen" on="2026-10-27" change="PR2918"/>
      <dependency type="spec" value="XP30 XP31 XQ30 XQ31"/>
      <test>fn:uri-collection("argument1","argument2")</test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

   <test-case name="fn-uri-collection-1a" covers-40="PR2918">
      <description>Evaluation of uri-collection function.</description>
      <created by="Christian Gruen" on="2026-10-27"/>
      <dependency type="spec" value="XP40+ XQ40+"/>
      <test>fn:uri-collection("argument1", {}, "argument3")</test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

   <test-case name="fn-uri-collection-2">
      <description> Evaluation of ana fn:uri-collection, which tries to retrieve a non-existent resource. Inspired by fn-collection-2. </description>
      <created by="Josh Spiegel" on="2012-10-02"/>
      <test>fn:uri-collection("thisfileshouldnotexists")</test>
      <result>
         <error code="FODC0002"/>
      </result>
   </test-case>

   <test-case name="fn-uri-collection-3">
      <description> Evaluation of ana fn:uri-collection with argument set to an invalid URI. Inspired by fn-collection-3.</description>
      <created by="Josh Spiegel" on="2012-10-02"/>
      <modified by="Michael Kay" on="2016-03-21" change="see bug 29404"/>
      <test>fn:uri-collection("invalidURI%gg")</test>
      <result>
         <any-of>
            <error code="FODC0004"/>
            <error code="FODC0002"/>
         </any-of>
      </result>
   </test-case>

   <test-case name="K2-SeqUriCollectionFunc-1">
      <description> Pass an invalid xs:anyURI to fn:uri-collection(). Inspired by K2-SeqCollectionFunc-1.</description>
      <created by="Josh Spiegel" on="2012-10-02"/>
      <modified by="Michael Kay" on="2016-03-21" change="see bug 29404"/>
      <test>uri-collection("http:\\invalidURI\someURI%gg")</test>
      <result>
         <any-of>
            <error code="FODC0004"/>
            <error code="FODC0002"/>
         </any-of>
      </result>
   </test-case>

   <test-case name="K2-SeqUriCollectionFunc-2">
      <description> ':/ is an invalid URI. Inspired by K2-SeqCollectionFunc-2.</description>
      <created by="Josh Spiegel" on="2012-10-02"/>
      <modified by="Michael Kay" on="2016-03-21" change="see bug 29404"/>
      <test>uri-collection(":/")</test>
      <result>
         <any-of>
            <error code="FODC0004"/>
            <error code="FODC0002"/>
         </any-of>
      </result>
   </test-case>
    
   <test-case name="uri-collection-901">
      <description>Unknown default resource collection. Inspired by collection-901.</description>
      <created by="Josh Spiegel" on="2012-10-02"/>
      <test>uri-collection()</test>
      <result>
         <error code="FODC0002"/>
      </result>
   </test-case>

   <test-case name="uri-collection-903">
      <description>Unknown default resource collection.</description>
      <created by="Josh Spiegel" on="2012-10-02"/>
      <test>uri-collection(())</test>
      <result>
         <error code="FODC0002"/>
      </result>
   </test-case>

   <test-case name="uri-collection-010" covers-40="PR2918">
      <description>Evaluation of uri-collection function.</description>
      <created by="Christian Gruen" on="2026-10-27"/>
      <dependency type="spec" value="XP40+ XQ40+"/>
      <test>uri-collection((), {})</test>
      <result>
         <error code="FODC0002"/>
      </result>
   </test-case>

   <test-case name="uri-collection-011" covers-40="PR2918">
      <description>Evaluation of uri-collection function.</description>
      <created by="Christian Gruen" on="2026-10-27"/>
      <environment ref="simple-collection-1"/>
      <dependency type="spec" value="XP40+ XQ40+"/>
      <test>uri-collection(xs:anyURI("collection1"), ())</test>
      <result>
         <all-of>
            <assert>count($result) = 2</assert>
            <assert-type>xs:anyURI*</assert-type>
         </all-of>
      </result>
   </test-case>

   <test-case name="uri-collection-012" covers-40="PR2918">
      <description>Evaluation of uri-collection function.</description>
      <created by="Christian Gruen" on="2026-10-27"/>
      <environment ref="simple-collection-1"/>
      <dependency type="spec" value="XP40+ XQ40+"/>
      <test>uri-collection("collection1", { "match": "BIB\.XML$", "match-flags": "i" }) ! ends-with(., "bib.xml")</test>
      <result>
         <assert-true/>
      </result>
   </test-case>

   <test-case name="uri-collection-013" covers-40="PR2918">
      <description>Evaluation of uri-collection function.</description>
      <created by="Christian Gruen" on="2026-10-27"/>
      <environment ref="simple-collection-1"/>
      <dependency type="spec" value="XP40+ XQ40+"/>
      <test>uri-collection("collection1", { "match": "[" })</test>
      <result>
         <error code="FORX0002"/>
      </result>
   </test-case>

   <test-case name="uri-collection-014" covers-40="PR2918">
      <description>Evaluation of uri-collection function.</description>
      <created by="Christian Gruen" on="2026-10-27"/>
      <environment ref="simple-collection-1"/>
      <dependency type="spec" value="XP40+ XQ40+"/>
      <test>uri-collection("collection1", { "recursive": "yes" })</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

</test-set>