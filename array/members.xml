<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="array-members" covers-40="array-members">
   <description>Tests for the proposed XPath 4.0 array:members() function</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/"
         idref="array-members"/>
   
   <dependency type="spec" value="XP40+ XQ40+"/>

   <test-case name="array-members-001">
      <description> Deconstruct an empty array </description>
      <created by="Michael Kay" on="2021-06-28"/>
      <test>array:members([])</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>
   
   <test-case name="array-members-002" covers-40="PR2814">
      <description> Deconstruct a singleton array </description>
      <created by="Michael Kay" on="2021-06-28"/>
      <modified by="Michael Kay" on="2023-03-22" change="revised spec using value records"/>
      <modified by="Michael Kay" on="2026-07-31" change="revised spec using JNodes - PR2814"/>
      <test>array:members([1]) ! jvalue()</test>
      <result>
         <assert-eq>1</assert-eq>
      </result>
   </test-case>
   
   <test-case name="array-members-003">
      <description> Deconstruct a more complex array </description>
      <created by="Michael Kay" on="2021-06-28"/>
      <test>array:members([1, (2,3)])</test>
      <result>
         <assert-count>2</assert-count>
      </result>
   </test-case>
   
   <test-case name="array-members-004" covers-40="PR2814">
      <description> Deconstruct a more complex array </description>
      <created by="Michael Kay" on="2021-06-28"/>
      <modified by="Michael Kay" on="2023-03-22" change="revised spec using value records"/>
      <modified by="Michael Kay" on="2026-07-31" change="revised spec using JNodes - PR2814"/>
      <test>array:members([1, (2,3)]) ! jvalue()</test>
      <result>
         <assert-deep-eq>1, 2, 3</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="array-members-005" covers-40="PR2814">
      <description> Deconstruct a more complex array </description>
      <created by="Michael Kay" on="2023-03-22"/>
      <modified by="Michael Kay" on="2026-07-31" change="revised spec using JNodes - PR2814"/>
      <test>array:members([1, (2,3), ()]) instance of jnode()*</test>
      <result>
         <assert-true/>
      </result>
   </test-case>
   
   <test-case name="array-members-006" covers-40="PR2814">
      <description> Deconstruct a more complex array </description>
      <created by="Michael Kay" on="2023-03-22"/>
      <modified by="Michael Kay" on="2026-07-31" change="revised spec using JNodes - PR2814"/>
      <test>array:members([1, (2,3), ()])</test>
      <result>
         <all-of>
            <assert>$result[1] ! jvalue() = 1</assert>
            <assert>deep-equal($result[2], jtree([(2,3)])/*)</assert>
            <assert>empty($result[3] ! jvalue())</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="array-members-007" covers-40="PR2814">
      <description> Properties of returned JNodes </description>
      <created by="Michael Kay" on="2021-06-28"/>
      <modified by="Michael Kay" on="2023-03-22" change="revised spec using value records"/>
      <modified by="Michael Kay" on="2026-07-31" change="revised spec using JNodes - PR2814"/>
      <test>array:members([10, 20])</test>
      <result>
         <all-of>
            <assert>jvalue($result[1]) = 10</assert>
            <assert>jvalue($result[2]) = 20</assert>
            <assert>jkey($result[1]) = 1</assert>
            <assert>jkey($result[2]) = 2</assert>
            <assert>$result[1]/.. is $result[2]/..</assert>
            <assert>deep-equal($result[1] ! jvalue(..), [10, 20])</assert>
            <assert>jposition($result[1]) = 1</assert>
            <assert>jposition($result[2]) = 1</assert>
         </all-of>
      </result>
   </test-case>
   
 
 

 
</test-set>
