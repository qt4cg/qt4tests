<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="array-reverse" covers="array-reverse"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <description>Tests for the array:reverse function introduced in XPath 3.1</description>
    <link type="spec" document="http://www.w3.org/TR/xpath-functions-31/" idref="func-array-reverse"/>
    <dependency type="spec" value="XP31+ XQ31+"/>

    
    <test-case name="array-reverse-801">
        <description>Return reversed order array with integer members</description>
        <created by="Debbie Lockett, Saxonica" on="2014-10-28"/>
        <environment ref="array"/>
        <test>array:reverse(["a", "b", "c", "d"])</test>
        <result>
            <all-of>
                <assert-type>array(*)</assert-type>
                <assert>array:size($result) eq 4</assert>
                <assert-deep-eq>["d", "c", "b", "a"]</assert-deep-eq>
            </all-of>
        </result>
    </test-case>
    <test-case name="array-reverse-802">
        <description>Return reversed order array with sequence members</description>
        <created by="Debbie Lockett, Saxonica" on="2014-10-28"/>
        <environment ref="array"/>
        <test>array:reverse([("a", "b"), ("c", "d")])</test>
        <result>
            <all-of>
                <assert-type>array(*)</assert-type>
                <assert>array:size($result) eq 2</assert>
                <assert-deep-eq>[("c", "d"), ("a", "b")]</assert-deep-eq>
            </all-of>
        </result>
    </test-case>
    <test-case name="array-reverse-803">
        <description>Return reversed order array with sequence member</description>
        <created by="Debbie Lockett, Saxonica" on="2014-10-28"/>
        <environment ref="array"/>
        <test>array:reverse([(1 to 5)])</test>
        <result>
            <all-of>
                <assert-type>array(*)</assert-type>
                <assert>array:size($result) eq 1</assert>
                <assert-deep-eq>[(1, 2, 3, 4, 5)]</assert-deep-eq>
            </all-of>
        </result>
    </test-case>
    <test-case name="array-reverse-804">
        <description>Return reversed order empty array</description>
        <created by="Debbie Lockett, Saxonica" on="2014-10-28"/>
        <environment ref="array"/>
        <test>array:reverse([])</test>
        <result>
            <all-of>
                <assert-type>array(*)</assert-type>
                <assert>array:size($result) eq 0</assert>
                <assert-deep-eq>[]</assert-deep-eq>
            </all-of>
        </result>
    </test-case>
    <test-case name="array-reverse-805">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse([ [ 1, 2 ], [ 3 ], [] ])</test>
        <result>
            <assert-deep-eq>[ [], [ 3 ], [ 1, 2 ] ]</assert-deep-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-806">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse([ (), 1, () ])</test>
        <result>
            <assert-deep-eq>[ (), 1, () ]</assert-deep-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-807">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse([ 1 ])</test>
        <result>
            <assert-deep-eq>[ 1 ]</assert-deep-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-808">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse(array { 1 to 100000 }) => array:get(1)</test>
        <result>
            <assert-eq>100000</assert-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-809">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>let $a := array { 1 to 10 } return deep-equal(array:reverse(array:reverse($a)), $a)</test>
        <result>
            <assert-true/>
        </result>
    </test-case>
    <test-case name="array-reverse-810">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse(array:subarray(array { 1 to 10 }, 3, 4))</test>
        <result>
            <assert-deep-eq>[ 6, 5, 4, 3 ]</assert-deep-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-811">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse([ 'a', 'b', 'c' ])?2</test>
        <result>
            <assert-eq>'b'</assert-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-812">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse((1, 2))</test>
        <result>
            <error code="XPTY0004"/>
        </result>
    </test-case>
    <test-case name="array-reverse-813">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse(())</test>
        <result>
            <error code="XPTY0004"/>
        </result>
    </test-case>
    <test-case name="array-reverse-814">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse(map { 1: 'a' })</test>
        <result>
            <error code="XPTY0004"/>
        </result>
    </test-case>
    <test-case name="array-reverse-815">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test>array:reverse#1([ 'x', 'y' ])</test>
        <result>
            <assert-deep-eq>[ 'y', 'x' ]</assert-deep-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-816">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test><![CDATA[array:reverse(if (current-date() lt xs:date('1900-01-01')) then [] else [ 1, 2, 3 ])]]></test>
        <result>
            <assert-deep-eq>[ 3, 2, 1 ]</assert-deep-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-817">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test><![CDATA[array:reverse([ string(parse-xml('<a>a</a>')), 'b', (), parse-xml('<a/>')//text() ])]]></test>
        <result>
            <assert-deep-eq>[ (), (), 'b', 'a' ]</assert-deep-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-818">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test><![CDATA[array:reverse(array:subarray(array { 1 to string-length(parse-xml('<a>abcdef</a>')) }, 2, 3))]]></test>
        <result>
            <assert-deep-eq>[ 4, 3, 2 ]</assert-deep-eq>
        </result>
    </test-case>
    <test-case name="array-reverse-819">
        <description>Evaluation of array:reverse function.</description>
        <created by="Christian Gruen" on="2026-10-02"/>
        <test><![CDATA[array:reverse(if (current-date() lt xs:date('1900-01-01')) then [] else 1)]]></test>
        <result>
            <error code="XPTY0004"/>
        </result>
    </test-case>
    



</test-set>