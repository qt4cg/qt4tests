   <test-case name="raytracer">
      <description>The raytracer demo, with the scene represented by an XML structure.</description>
      <created by="Nick Jones" on="2008-10-30"/>
      <modified by="Christian Gruen" on="2026-07-31" change="moved query to render.xq"/>
      <module uri="http://www.xqsharp.com/raytracer" location="Demos/raytracer/raytracer.xq" file="Demos/raytracer/raytracer.xq"/>
      <module uri="http://www.xqsharp.com/raytracer/scene" location="Demos/raytracer/scene.xq" file="Demos/raytracer/scene.xq"/>
      <module uri="http://www.xqsharp.com/raytracer/vector" location="Demos/raytracer/vector.xq" file="Demos/raytracer/vector.xq"/>
      <module uri="http://www.xqsharp.com/raytracer/shapes" location="Demos/raytracer/shapes.xq" file="Demos/raytracer/shapes.xq"/>
      <module uri="http://www.xqsharp.com/raytracer/materials" location="Demos/raytracer/materials.xq" file="Demos/raytracer/materials.xq"/>
      <module uri="http://www.xqsharp.com/raytracer/math" location="Demos/raytracer/math.xq" file="Demos/raytracer/math.xq"/>
      <dependency type="spec" value="XQ10+"/>
      <test file="Demos/raytracer/render.xq"/>
      <result>
         <all-of>
           <assert>starts-with(normalize-space(string-join($result, ' ')), 'P3 64 64 255 0 0 0')</assert>
           <assert>ends-with(
  normalize-space(string-join($result, ' ')),
  '125 119 179 125 118 178 124 118 177 124 117 176'
)</assert>
         </all-of>
      </result>
   </test-case>

