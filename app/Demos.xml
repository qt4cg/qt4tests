         </assert-deep-eq>
      </result>
   </test-case>

   <test-case name="diff-unified">
      <description>Compute the differences of two texts and render them in the unified diff format.</description>
      <created by="Christian Gruen" on="2026-11-02"/>
      <module uri="http://qt4cg.org/demos/diff" location="Demos/diff/diff.xqm" file="Demos/diff/diff.xqm"/>
      <dependency type="spec" value="XQ40+"/>
      <test file="Demos/diff/unified.xq"/>
      <result>
         <assert-deep-eq>
            '--- old',
            '+++ new',
            '@@ -1,3 +1,3 @@',
            ' Pancakes for four people',
            '-Ingredients: flour, milk, eggs, sugar, salt',
            '+Ingredients: flour, milk, eggs, sugar, salt, butter',
            ' Mix the flour with the sugar and the salt.',
            '@@ -5,3 +5,3 @@',
            ' Combine both mixtures and stir until smooth.',
            '-Let the batter rest for ten minutes.',
            '+Let the batter rest for thirty minutes.',
            ' Heat a pan with a little butter.',
            '@@ -9,4 +9,4 @@',
            ' Bake each side until golden.',
            '-Keep the pancakes warm in the oven.',
            ' Serve with jam or maple syrup.',
            '+Sprinkle with powdered sugar.',
            ' Enjoy your meal!'
         </assert-deep-eq>
      </result>
   </test-case>

