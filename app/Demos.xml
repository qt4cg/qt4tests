   <test-case name="fun-babel">
      <description>Parse arithmetic lines with an ixml grammar and evaluate them with references to earlier results.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <dependency type="spec" value="XQ40+"/>
      <test file="Demos/fun/babel.xq"/>
      <result>
         <assert-deep-eq>
            '$1 = 7 &#x27F5; 1 + 2 &#xD7; 3',
            '$2 = 81 &#x27F5; ($1 - 4) ^ 2 ^ 2',
            '$3 = 5 &#x27F5; hyp(sqrt($2) - 6, $1 - 3)',
            '$4 = 6 &#x27F5; fib($3 &#xD7; 2) % $1',
            '$5 = 36 &#x27F5; exp(log($4) &#xD7; 2)',
            '$6 = 0.138888889 &#x27F5; max($1, $5 &#xF7; $3) ^ -1',
            '$7 = NaN &#x27F5; 2 +&#xD7; 3 &#x2717; syntax: no parse',
            '$8 = NaN &#x27F5; nope(1) &#x2717; name: nope#1 is unknown',
            '$9 = NaN &#x27F5; $12 + 1 &#x2717; time: $12 lies in the future',
            'peak: $2',
            &lt;expr>&lt;call name="hyp">&lt;neg>&lt;ref>1&lt;/ref>&lt;/neg>&lt;exp>&lt;num>2&lt;/num>&lt;num>3&lt;/num>&lt;/exp>&lt;/call>&lt;/expr>
         </assert-deep-eq>
      </result>
   </test-case>

   <test-case name="fun-dense">
      <description>Use as many XQuery 4.0 features as possible in a single query.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <dependency type="spec" value="XQ40+"/>
      <test file="Demos/fun/dense.xq"/>
      <result>
         <assert-deep-eq>
            '5b{3}',
            'o4 r2',
            '1 4 9',
            '1 10 28',
            '111&#x2191;9232',
            '1 5 6 8 false true 9',
            '-1-1++-+',
            'X&#xB7;Q&#xB7;4',
            '1001_1011 1295 &#x3A9;&#x2192;&amp;amp;',
            xs:date('2026-11-17'),
            'a b c a b c @x #content',
            36e0,
            '2 2 1 3 1 1000 b',
            'b u true',
            '1 2 3 a1 b2 x y n 1 b true true',
            'xs:integer|xs:string|array(*)|map(*)|fn(*)|record(Q{z}q)',
            'x=y',
            'rejected',
            'e'
         </assert-deep-eq>
      </result>
   </test-case>

   <test-case name="fun-functions">
      <description>Call all kinds of functions in deeply nested ways.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <dependency type="spec" value="XQ40+"/>
      <test file="Demos/fun/functions.xq"/>
      <result>
         <assert-deep-eq>
            'unc r xq4',
            '&#x2039;Y.R.E.U.Q.X!&#x203A;',
            720,
            'b c d x z b c a',
            '1024 -2 2 -3 1.3 banana',
            'XLII R 42 3 &#x2717;',
            'abs/1 compose/1 &#x2205;/1 pair/2 integer/1 &#x2205;/1 &#x2205;/1 &#x2205;/2',
            '5 4 3 2 1 liftoff',
            'false true 12586269025',
            'desserts 99 4 a dd bb ccc',
            'LR HEY! 10 20 30 a- b-',
            '9 3 3 &#x2717;',
            '(div (* (+ x 1) (- x 1)) y)',
            '8 2 9 36 10'
         </assert-deep-eq>
      </result>
   </test-case>
</test-set>
