<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="prod-OtherwiseExpr" covers-40="otherwise">
   <description>Tests for the OtherwiseExpr production: 4.0 proposal</description>
             
   <dependency type="spec" value="XP40+ XQ40+"/>
   
   <test-case name="otherwise-001">
      <description>Basic test of operator</description>
      <created by="Michael Kay" on="2020-12-01"/>
      <environment ref="staff"/>
      <test>(//employee[empname='Freda'] otherwise //employee[empname='Carmen'])/city</test>
      <result>
        <assert-eq>"Vienna"</assert-eq>
      </result>
   </test-case> 
   
   <test-case name="otherwise-002">
      <description>Basic test of operator, repeated</description>
      <created by="Michael Kay" on="2020-12-01"/>
      <environment ref="staff"/>
      <test>(//employee[empname='Freda'] otherwise //employee[empname='Gretchen'] otherwise //employee[empname='Carmen'])/city</test>
      <result>
         <assert-eq>"Vienna"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="otherwise-003">
      <description>No error if not evaluated</description>
      <created by="Michael Kay" on="2020-12-01"/>
      <environment ref="staff"/>
      <test>//employee[empname='Carmen']/city otherwise (count(//employee) div count(//manager))</test>
      <result>
         <assert-eq>"Vienna"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="otherwise-004">
      <description>Precedence less than union operator</description>
      <created by="Michael Kay" on="2020-12-01"/>
      <environment ref="staff"/>
      <test>(//employee[empname='Freda'] | //employee[empname='Gertrude'] otherwise //employee[empname='Don'] | //employee[empname='Ed'])/city/string()</test>
      <result>
         <assert-deep-eq>"Deale", "Akron"</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="otherwise-005">
      <description>Precedence less than union operator</description>
      <created by="Michael Kay" on="2020-12-01"/>
      <environment ref="staff"/>
      <test>(//employee[empname='Don'] | //employee[empname='Gertrude'] otherwise //employee[empname='Freda'] | //employee[empname='Ed'])/city</test>
      <result>
         <assert-eq>"Deale"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="otherwise-006">
      <description>Precedence relative to multiplication operator</description>
      <created by="Michael Kay" on="2020-12-01"/>
      <modified by="Michael Kay" on="2024-02-20" change="precedence changed (results unaffected)"/>
      <environment ref="staff"/>
      <test>//employee[empname='Freda']/grade otherwise //employee[empname='Betty']/grade * 2</test>
      <result>
         <assert-eq>20</assert-eq>
      </result>
   </test-case>
   
   <test-case name="otherwise-007">
      <description>Precedence relative multiplication operator</description>
      <created by="Michael Kay" on="2020-12-01"/>
      <modified by="Michael Kay" on="2024-02-20" change="precedence changed (results different)"/>
      <environment ref="staff"/>
      <test>2 * //employee[empname='Betty']/grade otherwise //employee[empname='Freda']/grade</test>
      <result>
         <assert-eq>20</assert-eq>
      </result>
   </test-case>
   
   <test-case name="otherwise-008">
      <description>Precedence relative multiplication operator</description>
      <created by="Michael Kay" on="2020-12-01"/>
      <modified by="Michael Kay" on="2024-02-20" change="precedence changed (results different)"/>
      <environment ref="staff"/>
      <test>2 * //employee[empname='Linda']/grade otherwise 1 * //employee[empname='Betty']/grade</test>
      <result>
         <assert-eq>10</assert-eq>
      </result>
   </test-case>
   
   <test-case name="otherwise-009">
      <description>Maybe optimized statically</description>
      <created by="Michael Kay" on="2026-10-08"/>
      <environment ref="staff"/>
      <test>//employee[empname='Freda']/city[false()] otherwise //employee[empname='Carmen']/city</test>
      <result>
        <assert-eq>"Vienna"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="otherwise-010">
      <description>Maybe optimized statically</description>
      <created by="Michael Kay" on="2026-10-08"/>
      <environment ref="staff"/>
      <test>//employee[empname='Carmen']/city otherwise //employee[empname='Freda']/city[false()]</test>
      <result>
        <assert-eq>"Vienna"</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-020" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>1 otherwise error()</test>
      <result>
        <assert-eq>1</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-021" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>() otherwise error()</test>
      <result>
        <error code="FOER0000"/>
      </result>
   </test-case>

   <test-case name="otherwise-022" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>error() otherwise 1</test>
      <result>
        <error code="FOER0000"/>
      </result>
   </test-case>

   <test-case name="otherwise-023" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>(1 otherwise error()) otherwise error()</test>
      <result>
        <assert-eq>1</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-024" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>1 otherwise (error() otherwise error())</test>
      <result>
        <assert-eq>1</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-030" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>1 = () otherwise 1</test>
      <result>
        <assert-true/>
      </result>
   </test-case>

   <test-case name="otherwise-031" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>'a' || () otherwise 'b'</test>
      <result>
        <assert-eq>'a'</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-032" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>() || () otherwise 'b'</test>
      <result>
        <assert-eq>''</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-033" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>() + 1 otherwise 2</test>
      <result>
        <assert-eq>2</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-034" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test><![CDATA[for $i in 1 to 3 return $i[. > 1] otherwise 0]]></test>
      <result>
        <assert-deep-eq>0, 2, 3</assert-deep-eq>
      </result>
   </test-case>

   <test-case name="otherwise-040" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>() otherwise ()</test>
      <result>
        <assert-empty/>
      </result>
   </test-case>

   <test-case name="otherwise-041" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>(1, 2) otherwise 3</test>
      <result>
        <assert-deep-eq>1, 2</assert-deep-eq>
      </result>
   </test-case>

   <test-case name="otherwise-042" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>(false() otherwise true(), '' otherwise 'x', 0 otherwise 1)</test>
      <result>
        <assert-deep-eq>false(), '', 0</assert-deep-eq>
      </result>
   </test-case>

   <test-case name="otherwise-043" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>({} otherwise 1, [] otherwise 1)</test>
      <result>
        <assert-deep-eq>{}, []</assert-deep-eq>
      </result>
   </test-case>

   <test-case name="otherwise-044" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>(1 to 0) otherwise 'x'</test>
      <result>
        <assert-eq>'x'</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-050" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <dependency type="spec" value="XQ40+"/>
      <test><![CDATA[<a><otherwise>1</otherwise></a>/(otherwise otherwise otherwise) => string()]]></test>
      <result>
        <assert-eq>'1'</assert-eq>
      </result>
   </test-case>

   <test-case name="otherwise-051" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>1 otherwise</test>
      <result>
        <error code="XPST0003"/>
      </result>
   </test-case>

   <test-case name="otherwise-052" covers-40="PR1031">
      <description>Evaluation of otherwise expression.</description>
      <created by="Christian Gruen" on="2026-11-17"/>
      <test>otherwise 1</test>
      <result>
        <error code="XPST0003"/>
      </result>
   </test-case>

   
</test-set>
