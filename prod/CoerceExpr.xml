<?xml version="1.0" encoding="utf-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="prod-CoerceExpr" covers-40="PR3044">
   <description>Tests for the CoerceExpr production</description>
   <link type="spec" document="http://www.w3.org/TR/xquery-40/" idref="id-coerce"/>

   <dependency type="spec" value="XP40+ XQ40+"/>

   <test-case name="coerce-001">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>(1, 2) coerce as xs:double+</test>
      <result>
         <all-of>
            <assert-type>xs:double+</assert-type>
            <assert-deep-eq>1, 2</assert-deep-eq>
         </all-of>
      </result>
   </test-case>

   <test-case name="coerce-002">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>1.5 coerce as xs:float</test>
      <result>
         <all-of>
            <assert-type>xs:float</assert-type>
            <assert-eq>1.5</assert-eq>
         </all-of>
      </result>
   </test-case>

   <test-case name="coerce-003">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>3 coerce as xs:positiveInteger</test>
      <result>
         <assert-type>xs:positiveInteger</assert-type>
      </result>
   </test-case>

   <test-case name="coerce-004">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test><![CDATA[parse-xml('<a>1</a>')/a coerce as xs:integer]]></test>
      <result>
         <all-of>
            <assert-type>xs:integer</assert-type>
            <assert-eq>1</assert-eq>
         </all-of>
      </result>
   </test-case>

   <test-case name="coerce-005">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>xs:untypedAtomic('1.5') coerce as xs:decimal?</test>
      <result>
         <all-of>
            <assert-type>xs:decimal</assert-type>
            <assert-eq>1.5</assert-eq>
         </all-of>
      </result>
   </test-case>

   <test-case name="coerce-006">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>({ 'a': 1 } coerce as record(a as xs:double))?a</test>
      <result>
         <assert-type>xs:double</assert-type>
      </result>
   </test-case>

   <test-case name="coerce-007">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>([ 1, 2 ] coerce as array(xs:double))?*</test>
      <result>
         <assert-type>xs:double+</assert-type>
      </result>
   </test-case>

   <test-case name="coerce-008">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>() coerce as empty-sequence()</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>

   <test-case name="coerce-009">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>1 coerce as xs:double instance of xs:double</test>
      <result>
         <assert-true/>
      </result>
   </test-case>

   <test-case name="coerce-010">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>'1' castable as xs:integer coerce as xs:boolean</test>
      <result>
         <assert-true/>
      </result>
   </test-case>

   <test-case name="coerce-011">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>{ 'b': 1 } coerce as record(a)</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="coerce-012">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>(1, 2) coerce as xs:integer</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="coerce-013">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>() coerce as xs:integer</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="coerce-014">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>'1' coerce as xs:integer</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="coerce-015">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>1 coerce as xs:string</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="coerce-016">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>(fn($x) { $x } coerce as fn(xs:integer) as item()*)('a')</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="coerce-017">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>({ 0: false() } coerce as fn(xs:integer) as xs:boolean)?0</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>

   <test-case name="coerce-018">
      <description>Evaluation of coerce as expression.</description>
      <created by="Christian Gruen" on="2026-11-04"/>
      <test>1 coerce as</test>
      <result>
         <error code="XPST0003"/>
      </result>
   </test-case>
</test-set>
