<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="bin-from-base64url" covers-40="PR2910">
  <description>Tests for the bin:from-base64url function</description>

  <environment name="EXPath-binary">
    <namespace prefix="bin" uri="http://expath.org/ns/binary"/>
  </environment>

  <dependency type="feature" value="binary"/>

  <test-case name="bin-from-base64url-001">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url(())</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-002">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('')</test>
    <result>
      <all-of>
        <assert-type>xs:base64Binary</assert-type>
        <assert-eq>xs:base64Binary('')</assert-eq>
      </all-of>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-003">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('-_8')</test>
    <result>
      <all-of>
        <assert-type>xs:base64Binary</assert-type>
        <assert-eq>xs:base64Binary(xs:hexBinary('FBFF'))</assert-eq>
      </all-of>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-004">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('-_8=')</test>
    <result>
      <assert-eq>xs:base64Binary(xs:hexBinary('FBFF'))</assert-eq>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-005">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url(' -_ 8&#xA;=&#x9;')</test>
    <result>
      <assert-eq>xs:base64Binary(xs:hexBinary('FBFF'))</assert-eq>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-006">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('-_-_')</test>
    <result>
      <assert-eq>xs:base64Binary(xs:hexBinary('FBFFBF'))</assert-eq>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-007">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('SGVsbG8') => bin:decode-string()</test>
    <result>
      <assert-eq>'Hello'</assert-eq>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-008">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('SGVsbG8=') => bin:decode-string()</test>
    <result>
      <assert-eq>'Hello'</assert-eq>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-009">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('TWFu') => bin:to-octets()</test>
    <result>
      <assert-deep-eq>77, 97, 110</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-010">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('+/8=')</test>
    <result>
      <error code="Q{http://expath.org/ns/binary}conversion-error"/>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-011">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('-_/8')</test>
    <result>
      <error code="Q{http://expath.org/ns/binary}conversion-error"/>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-012">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('-=_8')</test>
    <result>
      <error code="Q{http://expath.org/ns/binary}conversion-error"/>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-013">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('A')</test>
    <result>
      <error code="Q{http://expath.org/ns/binary}conversion-error"/>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-014">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('-_9')</test>
    <result>
      <error code="Q{http://expath.org/ns/binary}conversion-error"/>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-015">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('-_8&#xE9;')</test>
    <result>
      <error code="Q{http://expath.org/ns/binary}conversion-error"/>
    </result>
  </test-case>

  <test-case name="bin-from-base64url-016">
    <description>Evaluation of bin:from-base64url.</description>
    <created by="Christian Gruen" on="2026-09-22"/>
    <environment ref="EXPath-binary"/>
    <test>bin:from-base64url('====')</test>
    <result>
      <assert-eq>xs:base64Binary('')</assert-eq>
    </result>
  </test-case>

</test-set>
