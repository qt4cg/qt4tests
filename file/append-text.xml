<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-append-text">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-appendText2-001">
    <description>Use file:append-text with two arguments</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.txt"), 
        file:append-text("test.txt", "a"),
        file:append-text("test.txt", "b"),
        file:append-text("test.txt", "c")
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>Q{http://expath.org/ns/file}read-text("test.txt") eq "abc"</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText2-002">
    <description>Use file:append-text writing to an existing file</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:append-text("test.txt", "d"),
        file:append-text("test.txt", "e"),
        file:append-text("test.txt", "f")
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>Q{http://expath.org/ns/file}read-text("test.txt") eq "abcdef"</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText2-003">
    <description>Use file:append-text writing empty string</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Christian Gruen" on="2026-02-09" change="avoid side effects"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XP30+ XQ30+"/>
    <test>
      file:delete("test.txt"),
      file:append-text("test.txt", "")
    </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>Q{http://expath.org/ns/file}read-text("test.txt") eq ""</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText2-004">
    <description>Use file:append-text : default encoding is UTF-8</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Christian Gruen" on="2026-02-09" change="avoid side effects"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XP30+ XQ30+"/>
    <test>
      file:delete("test.txt"),
      file:append-text("test.txt", "&#xa3;")
    </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>Q{http://expath.org/ns/file}read-text("test.txt", "UTF-8") eq "&#xa3;"</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText2-005">
    <description>Use file:append-text with two arguments: file is a directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:append-text(".", "abc")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}is-dir"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText2-006">
    <description>Use file:append-text with two arguments: attempt to create file in non-existent
      directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:append-text("nonexistent/file.xml", "abc")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}no-dir"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText3-001">
    <description>Use file:append-text with three arguments, UTF-8</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test2.txt"), 
        file:append-text("test2.txt", ("a"), "UTF-8"),
        file:append-text("test2.txt", ("b"), "UTF-8"),
        file:append-text("test2.txt", ("c"), "UTF-8"),
        file:append-text("test2.txt", ("&#xa3;"), "UTF-8")
        
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>Q{http://expath.org/ns/file}read-text("test2.txt") eq "abc&#xa3;"</assert>
        <assert>xs:hexBinary(Q{http://expath.org/ns/file}read-binary("test2.txt")) eq
          xs:hexBinary("616263C2A3")</assert>
        <!-- TODO: allow leading BOM? -->
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText3-002" covers-40="PR3002">
    <description>Use file:append-text with three arguments: UTF-16 encoding</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="Christian Gruen" on="2013-11-20" change="Alternative without BOM added"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Michael Kay" on="2021-08-30" change="Alternative little-endian result with a single BOM"/>
    <modified by="Michael Kay" on="2021-08-30" change="Alternative big-endian result with no BOM"/>
    <modified by="Christian Gruen" on="2026-10-27" change="PR3002"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test3.txt"), 
        file:append-text("test3.txt", ("a"), "UTF-16"),
        file:append-text("test3.txt", ("b"), "UTF-16"),
        file:append-text("test3.txt", ("c"), "UTF-16")
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <any-of>
          <assert>xs:hexBinary(Q{http://expath.org/ns/file}read-binary("test3.txt")) eq
                  xs:hexBinary("FEFF006100620063")</assert>
          <assert>xs:hexBinary(Q{http://expath.org/ns/file}read-binary("test3.txt")) eq
            xs:hexBinary("FFFE610062006300")</assert>
          <assert>xs:hexBinary(Q{http://expath.org/ns/file}read-binary("test3.txt")) eq
            xs:hexBinary("610062006300")</assert>
        </any-of>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText3-003">
    <description>Use file:append-text with three arguments: unsupported encoding</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test4.txt"), 
        file:append-text("test4.txt", "abc", "encoding-1234")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}unknown-encoding"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText3-004">
    <description>Use file:append-text with three arguments: file is a directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:append-text(".", "abc", "UTF-8")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}is-dir"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendText3-005">
    <description>Use file:append-text with two arguments: attempt to create file in non-existent
      directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:append-text("nonexistent/file.xml", "abc", "UTF-8")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}no-dir"/>
    </result>
  </test-case>
  
  <test-case name="EXPath-file-appendText3-006">
    <description>Use file:append-text with three arguments: encoding is an empty sequence</description>
    <created by="Michael Kay" on="2014-04-22"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Christian Gruen" on="2015-01-29" change="ensure that target is not directory"/>
    <modified by="Christian Gruen" on="2026-02-09" change="empty sequence results in UTF-8"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XP30+ XQ30+"/>
    <test>
        file:delete("test.txt"),
        file:append-text("test.txt", "abc", ())</test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>Q{http://expath.org/ns/file}read-text("test.txt", "UTF-8") eq "abc"</assert>
      </all-of>
    </result>
  </test-case>

  
</test-set>  