<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-last-modified">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-last-modified-001">
    <description>Use file:last-modified on a file</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Christian Gruen" on="2017-02-06" change="Adapted to FAT, GH71"/>
  <environment ref="EXPath-file"/>
    <test>
        file:append-text("test.txt", "a"),
        file:last-modified("test.txt")</test>
    <result>
      <all-of>
        <assert-type>xs:dateTime</assert-type>
        <assert>exists(timezone-from-dateTime($result))</assert>
        <assert>(current-dateTime() - $result) div xs:dayTimeDuration("PT1S") ge 0</assert>
        <assert>(current-dateTime() - $result) div xs:dayTimeDuration("PT1S") lt 10</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-last-modified-002">
    <description>Use file:last-modified on a directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Christian Gruen" on="2017-02-06" change="Adapted to FAT, GH71"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("testdir"), 
        file:create-dir("testdir"),
        file:last-modified("testdir")</test>
    <result>
      <all-of>
        <assert-type>xs:dateTime</assert-type>
        <assert>exists(timezone-from-dateTime($result))</assert>
        <assert>(current-dateTime() - $result) div xs:dayTimeDuration("PT1S") ge 0</assert>
        <assert>(current-dateTime() - $result) div xs:dayTimeDuration("PT1S") lt 10</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-last-modified-003">
    <description>Use file:last-modified on a non-existent path</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:last-modified("nonexistent.txt")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}not-found"/>
    </result>
  </test-case>
  
</test-set>  