<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-is-file">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  
  <test-case name="EXPath-file-isFile-001">
    <description>Use file:is-file on an existing file</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:is-file("test.bin")</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="EXPath-file-isFile-002">
    <description>Use file:is-file on an existing directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:is-file("../sandpit")</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="EXPath-file-isFile-003">
    <description>Use file:is-file on a non-existing file</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:is-file("nonexisting-file.txt")</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="EXPath-file-isFile-004">
    <description>Use file:is-file on the current directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:is-file(".")</test>
    <result>
      <assert-false/>
    </result>
  </test-case>
  
  <test-case name="EXPath-file-isFile-005">
    <description>Use file:is-file on a URI</description>
    <created by="Michael Kay" on="2014-04-22"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:is-file(xs:anyURI('test.bin'))</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="EXPath-file-isFile-006">
    <description>Use file:is-file on a QName</description>
    <created by="Michael Kay" on="2014-04-22"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:is-file(QName('http://saxon.sf.net/', 'local-name'))</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>
  
</test-set>  