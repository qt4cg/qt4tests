<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-parent">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-parent-001">
    <description>Use file:parent on a text file</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.txt"), 
        file:write-text("test.txt", "abc"),
        file:parent("test.txt")
    </test>
    <result>
      <any-of>
        <assert>matches($result, "/.*")</assert>
        <assert>matches($result, "[A-Za-z]:\\.*sandpit\\")</assert>
      </any-of>      
    </result>
  </test-case>
  <test-case name="EXPath-file-parent-002">
    <description>Use file:parent on a directory</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:parent("dir1")
    </test>
    <result>
      <any-of>
        <assert>matches($result, "/.*")</assert>
        <assert>matches($result, "[A-Za-z]:\\.*sandpit\\")</assert>
      </any-of> 
    </result>
  </test-case>
  <test-case name="EXPath-file-parent-003">
    <description>Use file:parent on a directory ignoring trailing slash</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:parent("dir1/")
    </test>
    <result>
      <any-of>
        <assert>matches($result, "/.*")</assert>
        <assert>matches($result, "[A-Za-z]:\\.*sandpit\\")</assert>
      </any-of> 
    </result>
  </test-case>
  <test-case name="EXPath-file-parent-004">
    <description>Use file:parent on root</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:parent("/")
    </test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  
</test-set>  