  <test-case name="EXPath-file-readTextLines1-013">
    <description>Use file:read-textlines with 2 args: unknown encoding</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2013-12-02"
      change="Corrected read to extract from test.txt not sandpit"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.txt"), 
        file:write-text("test.txt", ""),
        file:read-text-lines("test.txt", "UTF-82.3")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}unknown-encoding"/>
