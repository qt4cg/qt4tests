  <test-case name="EXPath-file-read-text-lines-fallback-001" covers-40="PR2510">
    <description>file:read-text</description>
    <created by="Norm Tovey-Walsh" on="2026-02-12"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XP40+ XQ40+"/>
    <test>
      file:read-text-lines("non-xml.txt")
    </test>
    <result>
      <error code="Q{http://expath.org/ns/file}io-error"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-read-text-lines-fallback-002" covers-40="PR2510">
    <description>file:read-text</description>
    <created by="Norm Tovey-Walsh" on="2026-02-12"/>
    <modified by="Michael Ennen" on="2026-09-18" change="Pass fallback in the options map"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XP40+ XQ40+"/>
    <test>
      file:read-text-lines("non-xml.txt", { "encoding": "UTF-8", "fallback": false() })
    </test>
    <result>
      <error code="Q{http://expath.org/ns/file}io-error"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-read-text-lines-fallback-003" covers-40="PR2510">
    <description>file:read-text</description>
    <created by="Norm Tovey-Walsh" on="2026-02-12"/>
    <modified by="Christian Gruen" on="2026-09-08" change="XML 1.1 repertoire is mandatory"/>
    <modified by="Michael Ennen" on="2026-09-18" change="Pass fallback in the options map"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XP40+ XQ40+"/>
    <test>
      file:read-text-lines("non-xml.txt", { "encoding": (), "fallback": true() })
    </test>
    <result>
      <assert>starts-with($result, "U0000=�")</assert>
    </result>
  </test-case>



  
</test-set>  