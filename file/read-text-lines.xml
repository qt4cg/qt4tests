  <test-case name="EXPath-file-readTextLines1-016" covers-40="PR2929">
    <description>Evaluation of file:read-text and file:read-text-lines.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:delete("test.txt"),
        file:write-binary("test.txt", xs:base64Binary(xs:hexBinary("FFFE61000D000A006200"))),
        file:read-text-lines("test.txt")</test>
    <result>
      <assert-deep-eq>"a", "b"</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="EXPath-file-readTextLines1-017" covers-40="PR2929">
    <description>Evaluation of file:read-text and file:read-text-lines.</description>
    <created by="Christian Gruen" on="2026-09-29"/>
