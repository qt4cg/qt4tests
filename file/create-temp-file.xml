<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-create-temp-file">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-createTempFile-001">
    <description>Create temporary file: in default location</description>
    <created by="John Lumley" on="2013-11-27"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:create-temp-file("EXPathFile",".tmp")
      </test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert>Q{http://expath.org/ns/file}exists($result)</assert>
        <assert>$result ne
          Q{http://expath.org/ns/file}create-temp-file("EXPathFile",".tmp")</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="EXPath-file-createTempFile-002">
    <description>Create temporary file: in defined location</description>
    <created by="John Lumley" on="2013-11-27"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        if (file:exists("temp")) then () else file:create-dir("temp"),
        file:create-temp-file("EXPathFile",".tmp","temp")
      </test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert>Q{http://expath.org/ns/file}exists($result)</assert>
        <assert>$result ne
          Q{http://expath.org/ns/file}create-temp-file("EXPathFile",".tmp","temp")</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="EXPath-file-createTempFile-003" covers-40="PR2077">
    <description>Create temporary file: no arguments</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:create-temp-file()
      </test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert>Q{http://expath.org/ns/file}is-file($result)</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="EXPath-file-createTempFile-004">
    <description>Prefix less than 3 chars: allowed in EXPath but not in Java</description>
    <created by="Michael Kay" on="2026-08-20"/>
    <environment ref="EXPath-file"/>
    <test>
        file:create-temp-file("Z", ".tmp")
      </test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert>Q{http://expath.org/ns/file}exists($result)</assert>
        <assert>$result ne
          Q{http://expath.org/ns/file}create-temp-file("EXPathFile",".tmp")</assert>
      </all-of>
    </result>
  </test-case>


  
</test-set>  