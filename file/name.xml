<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-name">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-name1-001">
    <description>Use file:name on a text file</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.txt"), 
        file:write-text("test.txt", "abc"),
        file:name("test.txt")
      </test>
    <result>
      <assert-eq>"test.txt"</assert-eq>
    </result>
  </test-case>
  <test-case name="EXPath-file-name1-002">
    <description>Use file:name on a directory</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:name("../sandpit")
      </test>
    <result>
      <assert-eq>"sandpit"</assert-eq>
    </result>
  </test-case>
  <test-case name="EXPath-file-name1-003">
    <description>Use file:name on a nonexistent file</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:name("nonexistent.txt")
      </test>
    <result>
      <assert-eq>"nonexistent.txt"</assert-eq>
    </result>
  </test-case>
  <test-case name="EXPath-file-name1-004">
    <description>Use file:name on current directory</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Christian Gruen" on="2015-02-20" change="test result fixed"/>
    <modified by="Michael Kay" on="2021-05-08" 
      change="change expected result: this test has been on the exceptions list for some years because the result
      seems inexplicable; I'm now changing the expected result."/>
    <modified by="Norm Tovey-Walsh" on="2026-02-06" 
      change="this test returns the name of the current working directory, which the test
              suite can't know in any implementation-independent way. I'm changing the
              test so that it simply checks that what's returned isn't the empty string."/>
    <environment ref="EXPath-file"/>
    <test>
        file:name(".")
    </test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert>$result != ''</assert>
      </all-of>
    </result>
  </test-case>
  <test-case name="EXPath-file-name1-005">
    <description>Use file:name on path with trailing separator</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:name("dir1/")
      </test>
    <result>
      <assert-eq>"dir1"</assert-eq>
    </result>
  </test-case>
  <test-case name="EXPath-file-name1-006">
    <description>Use file:name on root path</description>
    <created by="John Lumley" on="2013-12-02"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:name("/")
      </test>
    <result>
      <assert-eq>""</assert-eq>
    </result>
  </test-case>

  <test-case name="EXPath-file-name1-010" covers-40="PR3002">
    <description>Evaluation of file module functions</description>
    <created by="Christian Gruen" on="2026-10-27"/>
    <environment ref="EXPath-file"/>
    <test>
        file:name("file:///tmp/my%20file.txt")
      </test>
    <result>
      <assert-eq>"my file.txt"</assert-eq>
    </result>
  </test-case>

  
</test-set>  