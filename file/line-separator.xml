<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-line-separator">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-lineSeparator-001">
    <description>Use file:line-separator</description>
    <created by="Michael Kay" on="2012-06-15"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        string-to-codepoints(file:line-separator())
      </test>
    <result>
      <any-of>
        <assert-deep-eq>10</assert-deep-eq>
        <assert-deep-eq>13, 10</assert-deep-eq>
        <assert-deep-eq>13</assert-deep-eq>
      </any-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-lineSeparator-002">
    <description>Consistency of file:line-separator, file:path-separator, and
      file:dir-separator</description>
    <created by="Michael Kay" on="2012-06-15"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XP30+ XQ30+"/>
    <test>
        string-to-codepoints(file:path-separator() || file:dir-separator() || file:line-separator())
      </test>
    <result>
      <any-of>
        <assert-deep-eq>59, 92, 13, 10</assert-deep-eq>
        <!--windows-->
        <assert-deep-eq>58, 47, 10</assert-deep-eq>
        <!--unix-->
        <assert-deep-eq>58, 47, 13</assert-deep-eq>
        <!--mac (perhaps?)-->
      </any-of>
    </result>
  </test-case>


  
</test-set>  