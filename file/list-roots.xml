<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-list-roots">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-listRoots-001" covers-40="PR2077">
    <description>Use file:list-roots: every root is an existing directory</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:list-roots()
      </test>
    <result>
      <all-of>
        <assert-type>xs:string+</assert-type>
        <assert>every $r in $result satisfies Q{http://expath.org/ns/file}is-dir($r)</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-listRoots-002" covers-40="PR2077">
    <description>Use file:list-roots: every root is an absolute path</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <modified by="Michael Kay" on="2026-08-20" change="add assertions"/>
    <modified by="Christian Gruen" on="2026-08-25" change="syntax" />
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:list-roots()
      </test>
    <result>
      <all-of>
        <assert>every $r in $result satisfies Q{http://expath.org/ns/file}is-absolute($r)</assert>
        <assert>all-different($result)</assert>
        <any-of>
          <assert-eq>"/"</assert-eq>
          <assert>every $r in $result satisfies matches($r, "[A-Z]:\\")</assert>
        </any-of>
      </all-of>
    </result>
  </test-case>

  
</test-set>  