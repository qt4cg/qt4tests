<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-read-text">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-readText1-001">
    <description>Use file:read-text with 1 arg</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.txt"), 
        file:append-text("test.txt", "abcd"),
        file:read-text("test.txt")</test>
    <result>
      <all-of>
        <assert-eq>"abcd"</assert-eq>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-readText1-002">
    <description>Use file:read-text with 1 arg, file does not exist</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.txt"), 
        file:append-text("test.txt", "abcd"),
        file:read-text("nonexistent.txt")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}not-found"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-readText1-003">
    <description>Use file:read-text with 1 arg, file is directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.txt"), 
        file:append-text("test.txt", "abcd"),
        file:read-text(".")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}is-dir"/>
    </result>
  </test-case>

