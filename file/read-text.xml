    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.txt"), 
        file:write-binary("test.txt", 
                        xs:base64Binary(xs:hexBinary("A3"))),
        file:read-text("test.txt", "UTF-8")</test>
    <result>
      <error code="Q{http://expath.org/ns/file}io-error"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-readText1-004" covers-40="PR2077">
    <description>Use file:read-text, newline normalization</description>
    <created by="Christian Gruen" on="2026-09-16"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:delete("test.txt"),
        file:write-binary("test.txt", xs:base64Binary(xs:hexBinary("610D0A62"))),
        file:read-text("test.txt") => string-to-codepoints()</test>
    <result>
      <assert-deep-eq>97, 10, 98</assert-deep-eq>
    </result>
  </test-case>

