<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-append-binary">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-appendBinary2-001">
    <description>Use file:append-binary with two arguments</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("test.bin"), 
        file:append-binary("test.bin", xs:base64Binary(xs:hexBinary("0001020304")))</test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>xs:hexBinary(Q{http://expath.org/ns/file}read-binary("test.bin")) eq
          xs:hexBinary("0001020304")</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendBinary2-002">
    <description>Use file:append-binary with two arguments, append to existing file</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Christian Gruen" on="2026-02-09" change="avoid side effects"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XP30+ XQ30+"/>
    <test>
        file:delete("test.bin"),
        file:append-binary("test.bin", 
            xs:base64Binary(xs:hexBinary("05"))),
        file:append-binary("test.bin",
            xs:base64Binary(xs:hexBinary("06")))    
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>xs:hexBinary(Q{http://expath.org/ns/file}read-binary("test.bin")) eq
          xs:hexBinary("0506")</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendBinary2-003">
    <description>Use file:append-binary: file is a directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:append-binary(".", xs:base64Binary(""))</test>
    <result>
      <error code="Q{http://expath.org/ns/file}is-dir"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-appendBinary2-004">
    <description>Use file:append-binary: attempt to create file in non-existent
      directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:append-binary("nonexistent/file.bin", xs:base64Binary(""))
      </test>
    <result>
      <error code="Q{http://expath.org/ns/file}no-dir"/>
    </result>
  </test-case>


  
</test-set>  