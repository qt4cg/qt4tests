<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-delete">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-delete-001">
    <description>Delete simple file</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        if (file:exists("dir4")) then () else file:create-dir("dir4"),
        file:write-text("dir4/test.txt", "test"),
        file:delete("dir4/test.txt")
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>not(Q{http://expath.org/ns/file}exists("dir4/test.txt"))</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-delete-002">
    <description>Delete empty directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("dir4", true()),
        file:create-dir("dir4"),
        file:delete("dir4")
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>not(Q{http://expath.org/ns/file}exists("dir4"))</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-delete-003">
    <description>Delete directory and contents</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        if (file:exists("dir4")) then () else file:create-dir("dir4/dir5/dir6"),
        file:delete("dir4", true())
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>not(Q{http://expath.org/ns/file}exists("dir4"))</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-delete-004">
    <description>Fail to delete non-empty directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        if (file:exists("dir4")) then () else file:create-dir("dir4/dir5/dir6"),
        file:delete("dir4", false())
      </test>
    <result>
      <error code="Q{http://expath.org/ns/file}is-dir"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-delete-005">
    <description>Fail to delete non-empty directory</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <environment ref="EXPath-file"/>
    <test>
        file:delete("dir4", true()),
        file:create-dir("dir4"),
        file:write-text("dir4/test.txt", "grandmother"),
        file:delete("dir4")
      </test>
    <result>
      <error code="Q{http://expath.org/ns/file}is-dir"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-delete-006" covers-40="PR2548">
    <description>Delete non-existent file</description>
    <created by="Michael Kay" on="2012-06-11"/>
    <modified by="John Lumley" on="2014-08-11" change="consistent EXPath naming"/>
    <modified by="Christian Gruen" on="2026-04-02"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:delete("does-not-exist.txt")
      </test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="EXPath-file-delete-007" covers-40="PR2548">
    <description>Delete non-existent directory</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:delete("does-not-exist", true())
      </test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="EXPath-file-delete-008" covers-40="PR2548">
    <description>Delete a file twice</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:delete("dir4", true()),
        file:create-dir("dir4"),
        file:write-text("dir4/test.txt", "test"),
        file:delete("dir4/test.txt"),
        file:delete("dir4/test.txt")
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>not(Q{http://expath.org/ns/file}exists("dir4/test.txt"))</assert>
      </all-of>
    </result>
  </test-case>

  
</test-set>  