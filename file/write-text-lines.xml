<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="file-write-text">
  <description>Tests for the extension functions in the EXPath "file" package.
  The tests rely on being able to modify a “sandpit” folder. The sandpit element
  in the environment instructs the test driver to copy that folder to a
  “sandpit” directory in a temporary location and set the current working
  directory to that temporary location.
</description>

  <environment name="EXPath-file">
    <namespace prefix="file" uri="http://expath.org/ns/file"/>
    <sandpit path="sandpit"/>
  </environment>
  
  <dependency type="feature" value="expath-file"/>

  <test-case name="EXPath-file-writeTextLines2-001">
    <description>Use file:write-text-lines and read the lines back</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <test>
        file:write-text-lines("wtl.txt", ("a", "b", "c"))
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>deep-equal(Q{http://expath.org/ns/file}read-text-lines("wtl.txt"), ("a", "b", "c"))</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-writeTextLines2-002">
    <description>Use file:write-text-lines with an empty sequence</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <test>
        file:write-text-lines("wtl.txt", ())
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>empty(Q{http://expath.org/ns/file}read-text-lines("wtl.txt"))</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-writeTextLines2-003">
    <description>Use file:write-text-lines to overwrite an existing file</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <test>
        file:write-text-lines("wtl.txt", ("x", "y")),
        file:write-text-lines("wtl.txt", "a")
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>deep-equal(Q{http://expath.org/ns/file}read-text-lines("wtl.txt"), "a")</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-writeTextLines2-004">
    <description>Use file:write-text-lines with a directory as target</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <test>
        file:write-text-lines(".", "a")
      </test>
    <result>
      <error code="Q{http://expath.org/ns/file}is-dir"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-writeTextLines2-005">
    <description>Use file:write-text-lines with a non-existent parent directory</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <test>
        file:write-text-lines("nonexistent/wtl.txt", "a")
      </test>
    <result>
      <error code="Q{http://expath.org/ns/file}no-dir"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-writeTextLines3-001">
    <description>Use file:write-text-lines with an explicit encoding</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <test>
        file:write-text-lines("wtl.txt", ("a", "b"), "UTF-8")
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>deep-equal(Q{http://expath.org/ns/file}read-text-lines("wtl.txt"), ("a", "b"))</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-writeTextLines3-002">
    <description>Use file:write-text-lines with an unsupported encoding</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <test>
        file:write-text-lines("wtl.txt", "a", "no-such-encoding")
      </test>
    <result>
      <error code="Q{http://expath.org/ns/file}unknown-encoding"/>
    </result>
  </test-case>

  <test-case name="EXPath-file-writeTextLines3-003">
    <description>Use file:write-text-lines with an empty-sequence encoding (default UTF-8)</description>
    <created by="Christian Gruen" on="2026-07-10"/>
    <environment ref="EXPath-file"/>
    <test>
        file:write-text-lines("wtl.txt", ("x", "y"), ())
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>deep-equal(Q{http://expath.org/ns/file}read-text-lines("wtl.txt"), ("x", "y"))</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="EXPath-file-writeTextLines3-010" covers-40="PR3002">
    <description>Evaluation of file module functions</description>
    <created by="Christian Gruen" on="2026-10-27"/>
    <environment ref="EXPath-file"/>
    <dependency type="spec" value="XQ40+ XP40+"/>
    <test>
        file:write-text-lines("wtl.txt", lines := ("x", "y"))
      </test>
    <result>
      <all-of>
        <assert-empty/>
        <assert>deep-equal(Q{http://expath.org/ns/file}read-text-lines("wtl.txt"), ("x", "y"))</assert>
      </all-of>
    </result>
  </test-case>


  
</test-set>  